# Gemini API key (server-side only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=

# Optional: Supabase (enables Google Sign-In, saved split history, synced payment info, saved friends, and shareable bill links)
# Leave blank to run in zero-config Guest Mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
